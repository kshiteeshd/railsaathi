# ===== OS / Editor =====
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ===== Python / FastAPI backend =====
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.env/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.db
*.sqlite
*.sqlite3

# Backend secrets — NEVER commit real values
backend/.env
backend/.env.local
*.env.local
!.env.example

# Alembic versions are code — DO commit those.
# But ignore local migration noise if any.

# ===== Node / Vite frontend =====
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
frontend/.env.local
frontend/.env.development.local
frontend/.env.production.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Misc
data/seed/*.csv
data/seed/*.json
!data/seed/.gitkeep
