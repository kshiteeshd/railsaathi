# Copy this to .env and fill real values. NEVER commit .env.
# cp .env.example .env  (on Windows: copy .env.example .env)

# Postgres connection. Format for psycopg3 driver:
# postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rail_saathi

# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-secret-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
